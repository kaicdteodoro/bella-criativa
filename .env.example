APP_NAME="Bella Criativa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bela_criativa
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

WHATSAPP_NUMBER=5516999999999
IMPORT_IMAGE_QUALITY=80
IMPORT_DOWNLOAD_TIMEOUT=30
IMPORT_DOWNLOAD_ATTEMPTS=3
CATALOG_AI_CURATION_ENABLED=true
CATALOG_AI_PROVIDER=ollama
CATALOG_AI_MODEL=gemma3:4b
CATALOG_AI_BATCH_SIZE=20
CATALOG_AI_TEMPERATURE=0.2
CATALOG_AI_TIMEOUT=120
CATALOG_AI_MAX_TOKENS=4000
OLLAMA_URL=http://ollama:11434
CATALOG_DEFAULT_SUPPLIER=xbz

XBZ_CNPJ=
XBZ_TOKEN=

ASIA_IMPORT_API_KEY=
ASIA_IMPORT_SECRET_KEY=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contato@bellacriativa.com.br"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
